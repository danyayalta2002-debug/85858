<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090909">
<title>RUSKLIMAT NEXT — Премиальный климат</title>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

<style>
:root {
  --black:#090909;
  --panel:#13120f;
  --gold:#d6b36b;
  --light-gold:#f1d99e;
  --white:#f7f4ed;
  --muted:#aaa397;
  --line:rgba(214,179,107,.2);
}
* {box-sizing:border-box;margin:0;padding:0}
html {scroll-behavior:smooth}
body {
  background:var(--black);
  color:var(--white);
  font-family:Manrope,Arial,sans-serif;
}
a {color:inherit;text-decoration:none}
.container {width:min(1160px,92%);margin:auto}
.gold {color:var(--gold)}
header {
  position:sticky;top:0;z-index:20;
  background:rgba(9,9,9,.93);
  backdrop-filter:blur(15px);
  border-bottom:1px solid var(--line);
}
nav {
  min-height:78px;
  display:flex;align-items:center;
  justify-content:space-between;gap:25px;
}
.logo {display:flex;align-items:center;gap:12px}
.logo-icon {
  width:43px;height:43px;
  border:1px solid var(--gold);
  border-radius:12px;
  display:grid;place-items:center;
  color:var(--gold);
  font:27px "Playfair Display";
}
.logo-name {font-weight:800;letter-spacing:3px}
.logo-sub {
  display:block;color:var(--gold);
  font-size:9px;letter-spacing:3px;
}
.nav-links {display:flex;gap:28px;font-size:12px}
.nav-links a:hover {color:var(--gold)}
.button {
  display:inline-flex;align-items:center;
  justify-content:center;
  padding:14px 21px;
  background:linear-gradient(135deg,#f1d99e,#bd9148);
  color:#15110a;
  border:1px solid var(--gold);
  border-radius:5px;
  font-size:11px;font-weight:800;
  text-transform:uppercase;
  letter-spacing:1px;
  transition:.25s;
}
.button:hover {transform:translateY(-3px);filter:brightness(1.1)}
.button.outline {
  background:transparent;color:var(--light-gold);
}
.menu {
  display:none;background:none;
  border:1px solid var(--line);
  color:var(--gold);padding:8px 12px;
  font-size:20px;border-radius:5px;
}
.hero {
  min-height:590px;
  display:flex;align-items:center;
  position:relative;overflow:hidden;
  background:
  radial-gradient(ellipse at 80% 45%,rgba(180,135,60,.19),transparent 38%),
  linear-gradient(110deg,#090909,#15120c);
}
.hero:after {
  content:"R";
  position:absolute;right:7%;top:50%;
  transform:translateY(-50%);
  font:450px "Playfair Display";
  color:rgba(214,179,107,.055);
}
.hero-content {position:relative;z-index:2;padding:90px 0}
.eyebrow {
  color:var(--gold);
  font-size:11px;font-weight:800;
  letter-spacing:3px;text-transform:uppercase;
}
h1 {
  font:clamp(45px,7vw,78px)/1.05 "Playfair Display";
  margin:25px 0;
}
.hero p {
  max-width:520px;color:var(--muted);
  line-height:1.9;font-size:14px;
}
.hero-buttons {display:flex;gap:13px;flex-wrap:wrap;margin-top:30px}
.hero-note {
  margin-top:45px;color:#8e8679;
  font-size:10px;letter-spacing:2px;
}
.stats {
  border-block:1px solid var(--line);
  background:#0e0e0c;
}
.stats-grid {
  display:grid;grid-template-columns:repeat(3,1fr);
  padding:25px 0;
}
.stat {padding:5px 25px;border-right:1px solid var(--line)}
.stat:first-child {padding-left:0}
.stat:last-child {border:0}
.stat strong {
  display:block;font:30px "Playfair Display";
  color:var(--light-gold);
}
.stat span {font-size:10px;color:var(--muted)}
section {padding:85px 0}
.section-title {
  font:clamp(32px,4vw,47px) "Playfair Display";
  margin:15px 0;
}
.section-description {
  color:var(--muted);font-size:13px;
  max-width:550px;line-height:1.8;
}
.categories {
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:15px;margin-top:35px;
}
.category {
  min-height:215px;padding:25px;
  position:relative;overflow:hidden;
  background:linear-gradient(145deg,#1b1914,#10100e);
  border:1px solid var(--line);
  border-radius:9px;
  transition:.3s;
}
.category:hover {
  transform:translateY(-5px);
  border-color:var(--gold);
  box-shadow:0 15px 35px #0008;
}
.category-icon {
  width:48px;height:48px;
  border:1px solid var(--gold);
  color:var(--gold);
  display:grid;place-items:center;
  border-radius:12px;font-size:23px;
  margin-bottom:28px;
}
.category h3 {font-size:17px;margin-bottom:8px}
.category p {
  color:var(--muted);font-size:11px;
  line-height:1.7;max-width:250px;
}
.arrow {position:absolute;right:23px;top:25px;color:var(--gold)}
.about {
  background:linear-gradient(120deg,#15130f,#0b0b0a);
  border-block:1px solid var(--line);
}
.about-grid {
  display:grid;grid-template-columns:1fr 1fr;
  gap:55px;align-items:center;
}
.about h2 {
  font:clamp(34px,4vw,49px)/1.15 "Playfair Display";
  margin:18px 0;
}
.about p {color:var(--muted);font-size:13px;line-height:1.9}
.about-box {
  padding:30px;border:1px solid var(--line);
  border-radius:10px;
  background:rgba(214,179,107,.045);
}
.about-box h3 {
  color:var(--gold);font-size:12px;
  letter-spacing:2px;margin-bottom:22px;
}
.point {margin:18px 0;display:flex;gap:13px}
.point b {color:var(--gold)}
.point strong {font-size:13px}
.point p {font-size:11px;margin-top:4px}
.cta-box {
  padding:45px;
  border:1px solid var(--gold);
  border-radius:10px;
  background:radial-gradient(ellipse at 85% 50%,#b78d4525,transparent 45%),#11100d;
  display:flex;align-items:center;
  justify-content:space-between;gap:25px;
}
.cta-box h2 {font:38px "Playfair Display";margin:13px 0}
.cta-box p {font-size:12px;color:var(--muted)}
footer {
  padding:35px 0 22px;
  border-top:1px solid var(--line);
  background:#060606;
}
.footer-top {
  display:flex;justify-content:space-between;
  gap:20px;align-items:center;
}
.footer-links {display:flex;gap:20px;flex-wrap:wrap;font-size:11px;color:var(--muted)}
.footer-bottom {
  border-top:1px solid var(--line);
  margin-top:25px;padding-top:18px;
  color:#777;font-size:10px;
  display:flex;justify-content:space-between;gap:20px;
}
@media(max-width:800px) {
  .categories {grid-template-columns:repeat(2,1fr)}
  .about-grid {gap:25px}
  .nav-links {gap:15px}
}
@media(max-width:600px) {
  nav {min-height:70px}
  .menu {display:block}
  .nav-links {
    display:none;position:absolute;top:70px;
    left:0;right:0;background:#0b0b0a;
    padding:23px;flex-direction:column;
    border-bottom:1px solid var(--line);
  }
  .nav-links.open {display:flex}
  nav>.button {display:none}
  .hero {min-height:560px}
  .hero:after {right:-100px;font-size:330px}
  .hero-content {padding:70px 0}
  .categories {grid-template-columns:1fr}
  .stats-grid {grid-template-columns:1fr;gap:13px}
  .stat {border:0;border-bottom:1px solid var(--line);padding:10px 0}
  .stat:last-child {border:0}
  .about-grid {grid-template-columns:1fr}
  .cta-box {display:block;padding:28px}
  .cta-box .button {width:100%;margin-top:20px}
  .footer-top,.footer-bottom {display:block}
  .footer-links {margin-top:20px}
  .footer-bottom span {display:block;margin-top:10px}
}
</style>
</head>

<body>

<header>
<div class="container">
<nav>
  <a class="logo" href="#home">
    <span class="logo-icon">R</span>
    <span>
      <span class="logo-name">RUSKLIMAT</span>
      <span class="logo-sub">NEXT · PREMIUM CONCEPT</span>
    </span>
  </a>

  <div class="nav-links" id="navLinks">
    <a href="#categories">Каталог</a>
    <a href="#about">О компании</a>
    <a href="#official">Официальный сайт</a>
  </div>

  <a class="button" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">Каталог ↗</a>
  <button class="menu" id="menuBtn" aria-label="Открыть меню">☰</button>
</nav>
</div>
</header>

<main id="home">

<section class="hero">
<div class="container">
<div class="hero-content">
  <span class="eyebrow">Климатическая техника · инженерные решения</span>
  <h1>Комфорт —<br><span class="gold">это точность.</span></h1>
  <p>
    Климатические и инженерные решения для дома и бизнеса.
    Выберите нужное направление на RUSKLIMAT NEXT
    и переходите к полному ассортименту в официальном магазине.
  </p>

  <div class="hero-buttons">
    <a class="button" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">Смотреть каталог ↗</a>
    <a class="button outline" href="#categories">Выбрать категорию ↓</a>
  </div>

  <div class="hero-note">ПРЕМИАЛЬНАЯ ВИТРИНА · БЫСТРЫЙ ПЕРЕХОД К ПОКУПКЕ</div>
</div>
</div>
</section>

<div class="stats">
<div class="container stats-grid">
  <div class="stat"><strong>1996</strong><span>Год основания холдинга</span></div>
  <div class="stat"><strong>284</strong><span>Города присутствия</span></div>
  <div class="stat"><strong>80</strong><span>Брендов в ассортименте</span></div>
</div>
</div>

<section id="categories">
<div class="container">
  <span class="eyebrow">Выберите направление</span>
  <h2 class="section-title">Техника для <span class="gold">любого пространства</span></h2>
  <p class="section-description">
    Популярные категории собраны в одном месте.
    Полный ассортимент, цены и наличие смотрите на официальном сайте.
  </p>

  <div class="categories">

    <a class="category" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">
      <span class="arrow">↗</span>
      <div class="category-icon">❄</div>
      <h3>Кондиционирование</h3>
      <p>Сплит-системы, мобильные кондиционеры и климатические комплексы.</p>
    </a>

    <a class="category" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">
      <span class="arrow">↗</span>
      <div class="category-icon">⌁</div>
      <h3>Отопление</h3>
      <p>Радиаторы, конвекторы, котлы и решения для тепла.</p>
    </a>

    <a class="category" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">
      <span class="arrow">↗</span>
      <div class="category-icon">◎</div>
      <h3>Вентиляция</h3>
      <p>Оборудование для притока свежего и удаления отработанного воздуха.</p>
    </a>

    <a class="category" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">
      <span class="arrow">↗</span>
      <div class="category-icon">◌</div>
      <h3>Очистка и увлажнение</h3>
      <p>Очистители, увлажнители и комплексы для микроклимата.</p>
    </a>

    <a class="category" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">
      <span class="arrow">↗</span>
      <div class="category-icon">♨</div>
      <h3>Водонагреватели</h3>
      <p>Накопительные и проточные решения для горячей воды.</p>
    </a>

    <a class="category" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">
      <span class="arrow">↗</span>
      <div class="category-icon">⌘</div>
      <h3>Инженерные системы</h3>
      <p>Насосы, трубы, фитинги, автоматика и комплектующие.</p>
    </a>

  </div>
</div>
</section>

<section class="about" id="about">
<div class="container about-grid">

  <div>
    <span class="eyebrow">О холдинге</span>
    <h2>Опыт, который<br><span class="gold">создаёт климат.</span></h2>
    <p>
      «Русклимат» — торгово-производственный холдинг,
      работающий на рынке климатической техники с 1996 года.
      Компания развивает направления кондиционирования,
      вентиляции, отопления, водоснабжения и очистки воздуха.
    </p>
    <br>
    <a class="button outline" href="https://www.rusklimat.ru/" target="_blank" rel="noopener">Подробнее о компании ↗</a>
  </div>

  <div class="about-box">
    <h3>ПОЧЕМУ ВЫБИРАЮТ РУСКЛИМАТ</h3>

    <div class="point">
      <b>✦</b>
      <div><strong>Широкий ассортимент</strong>
      <p>Оборудование и комплектующие для разных задач.</p></div>
    </div>

    <div class="point">
      <b>✦</b>
      <div><strong>Для дома и бизнеса</strong>
      <p>От бытовой техники до инженерных проектов.</p></div>
    </div>

    <div class="point">
      <b>✦</b>
      <div><strong>Сервисная поддержка</strong>
      <p>Информация о сервисе и обслуживании на официальном сайте.</p></div>
    </div>
  </div>

</div>
</section>

<section id="official">
<div class="container">
  <div class="cta-box">
    <div>
      <span class="eyebrow">Следующий шаг</span>
      <h2>Нашли нужное направление?</h2>
      <p>Перейдите в официальный каталог за товарами, ценами и условиями покупки.</p>
    </div>
    <a class="button" href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">Открыть каталог ↗</a>
  </div>
</div>
</section>

</main>

<footer>
<div class="container">
  <div class="footer-top">
    <a class="logo" href="#home">
      <span class="logo-icon">R</span>
      <span>
        <span class="logo-name">RUSKLIMAT</span>
        <span class="logo-sub">NEXT · PREMIUM CONCEPT</span>
      </span>
    </a>

    <div class="footer-links">
      <a href="#categories">Категории</a>
      <a href="#about">О компании</a>
      <a href="https://www.rusklimat.ru/" target="_blank" rel="noopener">Официальный сайт ↗</a>
      <a href="https://www.rusklimat.ru/catalog" target="_blank" rel="noopener">Каталог ↗</a>
    </div>
  </div>

  <div class="footer-bottom">
    <span>© RUSKLIMAT NEXT · Концепт сайта</span>
    <span>Независимая концепция. Не является официальным сайтом холдинга.</span>
  </div>
</div>
</footer>

<script>
const menuBtn = document.getElementById("menuBtn");
const navLinks = document.getElementById("navLinks");

menuBtn.addEventListener("click", () => {
  navLinks.classList.toggle("open");
  menuBtn.textContent =
    navLinks.classList.contains("open") ? "×" : "☰";
});

navLinks.querySelectorAll("a").forEach(link => {
  link.addEventListener("click", () => {
    navLinks.classList.remove("open");
    menuBtn.textContent = "☰";
  });
});
</script>

</body>
</html>
